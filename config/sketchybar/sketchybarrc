#!/bin/bash

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
FONT="JetBrainsMono Nerd Font"

sketchybar --bar position=top height=36 margin=10 y_offset=4 corner_radius=12 \
  border_width=1 border_color=0xff494d64 color=0xee1e2030 shadow=on \
  blur_radius=24 padding_left=8 padding_right=8

sketchybar --default icon.font="$FONT:Semibold:14.0" icon.color=0xffcad3f5 \
  label.font="$FONT:Medium:13.0" label.color=0xffcad3f5 \
  background.corner_radius=8 background.height=26 padding_left=6 padding_right=6

for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add space "space.$sid" left \
    --set "space.$sid" associated_space="$sid" icon="$sid" label.drawing=off \
      icon.padding_left=9 icon.padding_right=9 background.drawing=on \
      background.color=0x00363a4f click_script="yabai -m space --focus $sid" \
      script="$PLUGIN_DIR/space.sh" \
    --subscribe "space.$sid" space_change
done

sketchybar --add item front_app left \
  --set front_app icon="●" icon.color=0xff8aadf4 label.max_chars=32 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock icon.drawing=off label.color=0xffc6a0f6 \
    background.drawing=on background.color=0xff24273a \
    background.border_width=1 background.border_color=0xff494d64 \
    update_freq=10 script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery icon.drawing=off label.color=0xffa6da95 \
    background.drawing=on background.color=0xff24273a \
    background.border_width=1 background.border_color=0xff494d64 update_freq=60 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --update
